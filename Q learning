===============================

STEP 5: INITIALIZE Q-TABLE

===============================

Q = np.zeros((n_states, n_actions))

alpha = 0.1    # learning rate

gamma = 0.9    # discount factor

epsilon = 0.2  # exploration

episodes = 300

episode_rewards = []

===============================

STEP 6: TRAIN Q-LEARNING AGENT

===============================

for ep in range(episodes):

# Start from initial state

state = str((2,0))

state_idx = state_to_index[state]



total_reward = 0

done = False



while not done:

    

    # ε-greedy policy

    if random.uniform(0,1) < epsilon:

        action = random.choice(actions_unique)

    else:

        action = actions_unique[np.argmax(Q[state_idx])]

    

    action_idx = action_to_index[action]

    

    # Get matching transitions from dataset

    subset = df[(df['state'].astype(str)==state) & (df['action']==action)]

    

    if subset.empty:

        break  # no transition available

    

    row = subset.sample(1).iloc[0]

    

    reward = row['reward']

    next_state = str(row['next_state'])

    done = row['done']

    

    next_state_idx = state_to_index[next_state]

    

    # Q-learning update formula

    Q[state_idx, action_idx] = Q[state_idx, action_idx] + alpha * (

        reward + gamma * np.max(Q[next_state_idx]) - Q[state_idx, action_idx]

    )

    

    state = next_state

    state_idx = next_state_idx

    

    total_reward += reward



episode_rewards.append(total_reward)

