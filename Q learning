STEP 2: DEFINE MOVEMENT FUNCTION

===============================

def move(state, action):

r, c = state



# Move agent within grid boundaries

if action == "Up":

    r = max(r-1, 0)

elif action == "Down":

    r = min(r+1, rows-1)

elif action == "Left":

    c = max(c-1, 0)

elif action == "Right":

    c = min(c+1, cols-1)



return (r, c)

